<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 밤하늘 그라데이션 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#0E1A3A"
                android:startColor="#1D4E6E"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- 오른쪽 위 빛 번짐 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.95"
                android:centerY="0.0"
                android:endColor="#008BE3CB"
                android:gradientRadius="260dp"
                android:startColor="#558BE3CB"
                android:type="radial" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- 유리 테두리 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
